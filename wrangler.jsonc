{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earningsviewer",
  "main": "./worker.js",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["15 15 * * *"]
  }
}
